CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
DOMAIN=example.com
# 逗號分隔。@ 代表根網域，沒有點的名稱會補上網域。
# Comma-separated. @ is the zone apex. A name without a dot is suffixed with the domain.
A_RECORDS=@
INTERVAL_SECONDS=30
DNS_TTL=60
DRY_RUN=false
# 多個網址以空白分隔。可填 Apprise 網址，或 https://主機/notify/token。
# Separate multiple URLs with spaces. Use an Apprise URL, or https://host/notify/token.
APPRISE_URLS=
